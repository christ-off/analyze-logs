<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ASN names, filled by the "Download ASN names" button on the ASN page from the quantcdn
         as-metadata CSV (asn, handle, description, country-code). `category` (isp, hosting, business…)
         is not in the CSV: it stays NULL until a source that provides it is imported. -->
    <changeSet id="026-asn-info" author="analyze-logs">
        <createTable tableName="asn_info">
            <column name="asn"          type="TEXT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="handle"       type="TEXT"/>
            <column name="name"         type="TEXT"/>
            <column name="country_code" type="TEXT"/>
            <column name="category"     type="TEXT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
